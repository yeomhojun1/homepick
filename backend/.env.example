# 백엔드 서버 포트 (프론트 dev 서버는 3001 을 사용한다)
PORT=4001

# PostgreSQL 접속 정보. <db-user>/<db-password> 를 실제 값으로 바꿔서 .env 로 복사할 것
DATABASE_URL=postgresql://<db-user>:<db-password>@localhost:5432/homepick

# JWT 서명 키. 운영에서는 반드시 긴 랜덤 문자열로 교체할 것
JWT_SECRET=<change-me-to-a-long-random-string>

# CORS 허용 origin (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3001

NODE_ENV=development
